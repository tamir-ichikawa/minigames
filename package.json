{
  "name": "minigame-platform",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev:maro": "node sample_game/斉藤さんゲーム/build.mjs --serve",
    "build:maro": "tsc --noEmit && node sample_game/斉藤さんゲーム/build.mjs",
    "test:maro": "node --test tests/maro-adventure.test.mjs && node tests/maro-adventure-browser.mjs",
    "dev:star-bounce": "node sample_game/STAR_BOUNCE/dev.mjs --serve",
    "build:star-bounce": "tsc --noEmit && node sample_game/STAR_BOUNCE/dev.mjs",
    "test:star-bounce-story": "node tests/star-bounce-story-browser.mjs",
    "dev": "node scripts/build.mjs --serve",
    "build": "tsc --noEmit && node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "test:browser": "npm run test:browser:new && npm run test:browser:existing",
    "preview": "node scripts/serve.mjs",
    "new-game": "node scripts/new-game.mjs",
    "dev:goatinanger": "npm --prefix sample_game/GOATinAnger run dev",
    "build:goatinanger": "npm --prefix sample_game/GOATinAnger run build",
    "test:goatinanger": "node --test sample_game/GOATinAnger/tests/*.test.js",
    "dev:dance": "node Dance/build.mjs --serve",
    "build:dance": "tsc --noEmit && node Dance/build.mjs",
    "test:dance": "node --test tests/dance.test.mjs",
    "test:browser:new": "node tests/maro-adventure-browser.mjs && node tests/added-games-browser.mjs",
    "test:browser:existing": "node tests/browser.mjs && node tests/goatinanger-browser.mjs && node tests/goatinanger-navigation-browser.mjs && node tests/goatinanger-startup-browser.mjs && node tests/star-bounce-story-browser.mjs"
  },
  "dependencies": {
    "phaser": "3.90.0"
  },
  "devDependencies": {
    "esbuild": "0.25.12",
    "typescript": "5.9.3",
    "@playwright/test": "1.56.1"
  }
}
